{
  "permissions": {
    "allow": [
      "mcp__fextralife__search_wiki",
      "mcp__fextralife__get_page",
      "mcp__fextralife__get_table",
      "mcp__fextralife__list_pages"
    ]
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENTPROF_BIN=$HOME/claude/agentprof/agentprof $HOME/claude/hooks/session-refresh/refresh-check.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/claude/hooks/handoff-resume/resume-check.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": true,
    "frontend-design@claude-plugins-official": true,
    "agentic@agentic-toolkit": true,
    "prompt-improver@severity1-marketplace": false
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "severity1-marketplace": {
      "source": {
        "source": "github",
        "repo": "severity1/severity1-marketplace"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "fastMode": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true
}
